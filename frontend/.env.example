# Base URL of the Delta Connector backend API.
# Local dev defaults to http://localhost:8000 (see src/lib/api.ts).
# In production set this to your deployed backend, e.g.:
#   VITE_API_BASE=https://delta-connector-api.onrender.com
# NOTE: Vite inlines this at BUILD time, so changing it requires a rebuild.
VITE_API_BASE=http://localhost:8000
